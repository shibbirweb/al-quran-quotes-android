<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 (API 30) and lower.
   See https://developer.android.com/guide/topics/data/autobackup
   The Room database only holds bundled ayahs that are re-seeded from assets,
   so it is excluded from backup.
-->
<full-backup-content>
    <exclude domain="database" path="." />
</full-backup-content>
