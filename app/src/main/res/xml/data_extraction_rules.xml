<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device transfer rules for Android 12 (API 31) and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   Everything is included in cloud backup and device transfer, including the Room database,
   because it holds the quotes the user added and the bundled ayahs they edited or deleted. A
   restored database may carry an older bundled ayah seed; the seed version check merges the
   current seed on the next start without undoing any of the user's changes.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
