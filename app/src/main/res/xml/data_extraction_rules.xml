<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device transfer rules for Android 12 (API 31) and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   The Room database only holds bundled ayahs that are re-seeded from assets,
   so it is excluded from both cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
